    "io.github.pad01g.matching": {
      "metadata": {
        "added": 1789800429000,
        "categories": [
          "Connectivity"
        ],
        "issueTracker": "https://github.com/pad01g/matching-frontend/issues",
        "lastUpdated": 1789800429000,
        "license": "MIT",
        "sourceCode": "https://github.com/pad01g/matching-frontend",
        "featureGraphic": {
          "en-US": {
            "name": "/io.github.pad01g.matching/en-US/featureGraphic_QsUPOZmaSDnxF1zXqosNV0ed7WuVmvefcMH5Ud-AcEw=.png",
            "sha256": "42c50f39999a4839f1175cd7aa8b0d57479ded6b959af79f70c1f951df80704c",
            "size": 43090
          }
        },
        "authorName": "pad01g",
        "name": {
          "en-US": "Matching"
        },
        "summary": {
          "en-US": "条件の合う相手を探して、マッチしたら話せる"
        },
        "description": {
          "en-US": "条件の合う相手を 1 人ずつ表示し、「いいね」か「パス」を選びます。\nお互いが「いいね」したらマッチが成立し、メッセージのやり取りができます。\n\nできること:\n\n* ユーザー名とパスワードで登録・ログイン\n* 年齢と性別で相手を絞り込む\n* カードをめくる感覚で相手を見ていく\n* プロフィール写真を 6 枚まで登録 (端末で縮小してから送ります)\n* マッチした相手とのメッセージ\n\nこのアプリについて:\n\n* **本人確認 (KYC) はありません。** 相手が名乗っているとおりの人物である\n  保証はありません。\n* **登録した写真は作者のサーバに保存されます。** 写真を 1 枚も\n  登録していない場合は、利用者 ID から生成した図形が代わりに出ます。\n* **作者が個人で運用しているサーバが停止していると使えません。**\n  アカウントもメッセージもそのサーバにしかないためです。"
        },
        "icon": {
          "en-US": {
            "name": "/io.github.pad01g.matching/en-US/icon_lW2yfNn-yZVEwV9XgWRneEE8x2db8snbCMSQjVy_MAk=.png",
            "sha256": "956db27cd9fec99544c15f5781646778413cc7675bf2c9db08c4908d5cbf3009",
            "size": 15985
          }
        },
        "preferredSigner": "69de51426bc600ff435bc5756889037ae094290a577bbe0f03d2e5efdb855dd3"
      },
