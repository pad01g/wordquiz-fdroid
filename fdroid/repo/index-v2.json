    "io.github.pad01g.p2pchess": {
      "metadata": {
        "added": 1789654678000,
        "categories": [
          "Games"
        ],
        "issueTracker": "https://github.com/pad01g/chess-frontend/issues",
        "lastUpdated": 1789800025000,
        "license": "MIT",
        "sourceCode": "https://github.com/pad01g/chess-frontend",
        "featureGraphic": {
          "en-US": {
            "name": "/io.github.pad01g.p2pchess/en-US/featureGraphic_mF7XOANEdVjnuvY-ae1IAUfRZcEG35jJsWUNfDXt98M=.png",
            "sha256": "985ed73803447558e7baf63e69ed480147d165c106df98c9b1650d7c35edf7c3",
            "size": 16002
          }
        },
        "authorName": "pad01g",
        "name": {
          "en-US": "P2P Chess"
        },
        "summary": {
          "en-US": "端末どうしが直接つながって指すチェス"
        },
        "description": {
          "en-US": "部屋コードを相手に伝えるだけで対局できるチェスです。\n対局中の指し手は、できるかぎり端末どうしが直接やり取りします\n(WebRTC の DataChannel)。\n\n直接つなげない回線では中継サーバを挟み、それも駄目なときは\n待ち合わせサーバが指し手を中継します。\nいまどの経路で繋がっているかは対局画面に表示されます。\n\n同じ端末での 2 人対戦、課題局面、定跡の閲覧はオフラインでも使えます。\n\nアカウント登録はありません。棋譜と設定は端末の中にだけ保存されます。\n\n注意: 端末どうしを直接つなぐ方式の性質上、対戦相手にあなたの\nIP アドレスが見えます。気になる場合は設定から\n「相手に IP アドレスを見せない」を有効にすると、\n常に中継サーバを経由するようになります。"
        },
        "icon": {
          "en-US": {
            "name": "/io.github.pad01g.p2pchess/en-US/icon_ptSyocSnyGwj6W5SMZUzyzZgZazq_ddJj45wsAKumuU=.png",
            "sha256": "a6d4b2a1c4a7c86c23e96e52319533cb366065aceafdd7498f8e70b002ae9ae5",
