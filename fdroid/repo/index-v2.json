              "minSdkVersion": 23,
              "targetSdkVersion": 35
            },
            "signer": {
              "sha256": [
                "69de51426bc600ff435bc5756889037ae094290a577bbe0f03d2e5efdb855dd3"
              ]
            },
            "usesPermission": [
              {
                "name": "android.permission.INTERNET"
              },
              {
                "name": "android.permission.WAKE_LOCK"
              },
              {
                "name": "android.permission.ACCESS_NETWORK_STATE"
              },
              {
                "name": "android.permission.RECEIVE_BOOT_COMPLETED"
              },
              {
                "name": "android.permission.FOREGROUND_SERVICE"
              },
              {
                "name": "io.github.pad01g.matching.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
              }
            ]
          },
          "antiFeatures": {
            "NonFreeNet": {
              "en-US": "このアプリは、作者が運用するソース非公開のサーバが無いと\n**一切動きません**。アカウント・プロフィール・マッチ・メッセージは\nすべてそのサーバに保存され、端末の中だけで完結する機能はありません。\n\nサーバが停止していればログインもできません。\nまた、そのサーバのソースコードは公開されていないため、\nあなたのデータがどう扱われるかを利用者が検証することはできません。\n\nこれは動作確認用のサンプルなので、実際の個人情報を入れないでください。"
            }
          }
        }
      }
    },
    "io.github.pad01g.p2pchess": {
      "metadata": {
        "added": 1789654678000,
        "categories": [
          "Games"
        ],
        "issueTracker": "https://github.com/pad01g/chess-frontend/issues",
        "lastUpdated": 1789800025000,
        "license": "MIT",
        "sourceCode": "https://github.com/pad01g/chess-frontend",
        "authorName": "pad01g",
        "name": {
          "en-US": "P2P Chess"
        },
        "summary": {
          "en-US": "端末どうしが直接つながって指すチェス"
        },
        "description": {
          "en-US": "部屋コードを相手に伝えるだけで対局できるチェスです。\n対局中の指し手は、できるかぎり端末どうしが直接やり取りします\n(WebRTC の DataChannel)。\n\n直接つなげない回線では中継サーバを挟み、それも駄目なときは\n待ち合わせサーバが指し手を中継します。\nいまどの経路で繋がっているかは対局画面に表示されます。\n\n同じ端末での 2 人対戦、課題局面、定跡の閲覧はオフラインでも使えます。\n\nアカウント登録はありません。棋譜と設定は端末の中にだけ保存されます。\n\n注意: 端末どうしを直接つなぐ方式の性質上、対戦相手にあなたの\nIP アドレスが見えます。気になる場合は設定から\n「相手に IP アドレスを見せない」を有効にすると、\n常に中継サーバを経由するようになります。"
        },
        "preferredSigner": "2c3e1def26ea6342ca658fc1d4e6452d802cc7969c7dffd1f03963333d20f543"
      },
      "versions": {
